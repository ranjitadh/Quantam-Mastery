{
  "name": "quantum-mastery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:auto": "./scripts/dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:setup": "./scripts/setup-db.sh",
    "db:start": "pg_ctl -D /opt/homebrew/var/postgresql@15 -l /opt/homebrew/var/log/postgresql@15.log start",
    "db:stop": "pg_ctl -D /opt/homebrew/var/postgresql@15 stop",
    "db:status": "pg_isready && echo '✅ PostgreSQL is running' || echo '❌ PostgreSQL is not running'"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.2",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.3.1",
    "framer-motion": "^11.0.5",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.344.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.51.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^3.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.19",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.35",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
